PORT=8080

DB_HOST=db.example.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=0
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
SECURITY_LOG_LEVEL=INFO

SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=
ADMIN_USER_IDS=

# Public frontend origin used by Stripe for success/cancel/portal redirects.
FRONTEND_URL=http://localhost:5173

# Server-only Stripe values. Never expose these in the frontend.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PREMIUM_PRICE_ID=price_...
BILLING_ENABLED=false
